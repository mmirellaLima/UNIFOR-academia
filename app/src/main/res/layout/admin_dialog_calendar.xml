<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="8dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/admin_previous_month"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/admin_calendar_previous"
            android:textColor="@android:color/black"
            android:contentDescription="@string/admin_previous_month"
            android:clickable="true"
            android:focusable="true" />
        <TextView
            android:id="@+id/admin_calendar_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            android:fontFamily="sans-serif" />
        <TextView
            android:id="@+id/admin_next_month"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/admin_calendar_next"
            android:textColor="@android:color/black"
            android:contentDescription="@string/admin_next_month"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
    <GridLayout
        android:id="@+id/admin_calendar_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7"
        android:rowCount="7" />
</LinearLayout>
