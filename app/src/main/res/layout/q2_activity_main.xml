<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/q2_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191A1E">
    <com.example.myapplication.questionario2.RegistrationBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageButton
        android:id="@+id/q2_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/q2_back_arrow"
        android:contentDescription="@string/q2_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/q2_step"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/q2_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ScrollView
        android:id="@+id/q2_form_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/q2_back_button"
        app:layout_constraintBottom_toTopOf="@id/q2_next_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">
            <ImageView
                android:layout_width="57dp"
                android:layout_height="57dp"
                android:padding="14dp"
                android:background="@drawable/q2_badge_background"
                android:src="@drawable/q2_dumbbell"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:text="@string/q2_source_question"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="0dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="28dp"
                android:orientation="vertical">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/q2_option_instagram"
                    style="@style/Q2SourceOption"
                    android:text="@string/q2_instagram" />
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/q2_option_facebook"
                    style="@style/Q2SourceOption"
                    android:text="@string/q2_facebook" />
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/q2_option_youtube"
                    style="@style/Q2SourceOption"
                    android:text="@string/q2_youtube" />
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/q2_option_referral"
                    style="@style/Q2SourceOption"
                    android:text="@string/q2_referral" />
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/q2_option_google"
                    style="@style/Q2SourceOption"
                    android:text="@string/q2_google" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <androidx.appcompat.widget.AppCompatCheckBox
                        android:id="@+id/q2_option_other"
                        style="@style/Q2SourceOption"
                        android:layout_width="90dp"
                        android:text="@string/q2_other" />
                    <EditText
                        android:id="@+id/q2_other_input"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="48dp"
                        android:enabled="false"
                        android:inputType="textCapSentences"
                        android:singleLine="true"
                        android:maxLength="120"
                        android:hint="@string/q2_other_hint"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#D3DDF5"
                        android:background="@drawable/q2_other_input_background"
                        android:paddingHorizontal="8dp"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/q2_next_button"
        android:layout_width="134dp"
        android:layout_height="54dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/q2_next_background"
        app:backgroundTint="#2D238D"
        android:text="@string/q2_next"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="2dp"
        android:text="@string/q2_progress_value"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/q2_registration_progress" />
    <ProgressBar
        android:id="@+id/q2_registration_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="26dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="55"
        android:progressDrawable="@drawable/q2_registration_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
