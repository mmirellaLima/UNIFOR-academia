<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ob_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ob_background">
    <com.example.myapplication.onboarding.RegistrationBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageButton
        android:id="@+id/ob_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ob_back"
        android:src="@drawable/ic_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/ob_termos_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginTop="110dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/ob_termos_title"
        android:textColor="@color/ob_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ob_back_button" />
    <LinearLayout
        android:id="@+id/ob_terms_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="26dp"
        android:layout_marginTop="44dp"
        android:gravity="top"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ob_termos_title">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/ob_checkbox_termos"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:background="@null"
            android:button="@drawable/ob_terms_checkbox" />
        <TextView
            android:id="@+id/ob_text_termos_statement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="3dp"
            android:text="@string/ob_termos_checkbox_text"
            android:textColor="@color/ob_white"
            android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/ob_progress_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="2dp"
        android:text="@string/ob_termos_progress_value"
        android:textColor="@color/ob_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/ob_registration_progress"
        app:layout_constraintEnd_toEndOf="parent" />
    <ProgressBar
        android:id="@+id/ob_registration_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="26dp"
        android:layout_marginBottom="16dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/ob_registration_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
