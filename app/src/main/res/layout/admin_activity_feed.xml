<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/admin_feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="DuplicateIncludedIds"
    tools:background="@color/admin_background"
    tools:context=".admin.FeedAdministradorActivity"
    android:background="@color/admin_background"
    android:theme="@style/Theme.MyApplication.Admin">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/admin_feed_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/admin_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/admin_gutter"
            android:paddingTop="@dimen/admin_header_top"
            android:paddingBottom="@dimen/admin_scroll_bottom">
            <ImageButton
                android:id="@+id/admin_back_button"
                android:layout_width="@dimen/admin_touch_target"
                android:layout_height="@dimen/admin_touch_target"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/admin_back"
                android:src="@drawable/ic_voltar" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_header_gap"
                android:layout_marginBottom="@dimen/admin_header_bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="@dimen/admin_avatar_size"
                    android:layout_height="@dimen/admin_avatar_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/admin_ic_avatar" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_greeting"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif" />
                    <TextView
                        style="@style/AdminText.Heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/admin_name"
                        android:textSize="@dimen/admin_name_size" />
                </LinearLayout>
            </LinearLayout>
            <include
                android:id="@+id/admin_next_activity"
                layout="@layout/admin_next_activity" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_spacing"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="11dp"
                    android:background="@drawable/admin_card_background"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_stat_card_padding">
                    <TextView
                        style="@style/AdminText.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_today_count"
                        android:textSize="@dimen/admin_name_size" />
                    <TextView
                        style="@style/AdminText.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_stat_card_gap"
                        android:text="@string/admin_today_classes"
                        android:textSize="@dimen/admin_body_size" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/admin_card_background"
                    android:orientation="vertical"
                    android:padding="@dimen/admin_stat_card_padding">
                    <TextView
                        style="@style/AdminText.Value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_total_minutes"
                        android:textSize="@dimen/admin_name_size" />
                    <TextView
                        style="@style/AdminText.Muted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/admin_stat_card_gap"
                        android:text="@string/admin_total_time"
                        android:textSize="@dimen/admin_body_size" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                style="@style/AdminText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_spacing"
                android:textColor="@color/admin_text_secondary"
                android:text="@string/admin_week" />
            <LinearLayout
                android:id="@+id/admin_week_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_week_gap"
                android:gravity="center"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/admin_week_height"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_done"
                        android:text="@string/admin_initial_s"
                        android:textColor="@color/admin_primary"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_monday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/admin_week_height"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_done"
                        android:text="@string/admin_initial_t"
                        android:textColor="@color/admin_primary"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_tuesday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/admin_week_height"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_today"
                        android:text="@string/admin_initial_q"
                        android:textColor="@color/admin_text"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_wednesday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/admin_week_height"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_pending"
                        android:text="@string/admin_initial_q"
                        android:textColor="@color/admin_outline"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_thursday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/admin_week_height"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_pending"
                        android:text="@string/admin_initial_s"
                        android:textColor="@color/admin_outline"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_friday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="@dimen/admin_week_height"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_pending"
                        android:text="@string/admin_initial_s"
                        android:textColor="@color/admin_outline"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_saturday" />
                </FrameLayout>
            </LinearLayout>
            <TextView
                style="@style/AdminText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_today_gap"
                android:accessibilityHeading="true"
                android:text="@string/admin_today" />
            <include
                android:id="@+id/admin_strength_activity"
                layout="@layout/admin_today_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_activity_gap" />
            <include
                android:id="@+id/admin_yoga_activity"
                layout="@layout/admin_yoga_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_activity_gap" />
            <FrameLayout
                android:id="@+id/admin_add_activity_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/admin_add_row_height"
                android:layout_marginTop="@dimen/admin_add_gap"
                android:clipChildren="false">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/admin_add_activity"
                    style="@style/AdminButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/admin_button_height"
                    android:layout_marginHorizontal="24dp"
                    android:text="@string/admin_add_activity" />
                <ImageView
                    android:id="@+id/admin_accessibility_badge"
                    android:layout_width="@dimen/admin_badge_size"
                    android:layout_height="@dimen/admin_badge_size"
                    android:background="@drawable/admin_accessibility_background"
                    android:src="@drawable/ic_fonte"
                    android:padding="6dp"
                    android:importantForAccessibility="no"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="@dimen/admin_badge_outset" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <include
        android:id="@+id/admin_bottom_navigation"
        layout="@layout/admin_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
