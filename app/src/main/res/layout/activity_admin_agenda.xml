<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feed_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/admin_background"
    tools:context=".admin.AdminAgendaActivity"
    tools:ignore="DuplicateIncludedIds">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation">
        <LinearLayout
            android:id="@+id/screen_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/admin_gutter"
            android:paddingBottom="64dp">
            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="@dimen/admin_touch_target"
                android:layout_height="@dimen/admin_touch_target"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/admin_back"
                android:src="@drawable/ic_voltar" />
            <TextView
                style="@style/AdminText.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/admin_week" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_done"
                        android:text="@string/admin_initial_s"
                        android:textColor="@color/admin_primary"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_monday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_done"
                        android:text="@string/admin_initial_t"
                        android:textColor="@color/admin_primary"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_tuesday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_today"
                        android:text="@string/admin_initial_q"
                        android:textColor="@color/admin_text"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_wednesday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_pending"
                        android:text="@string/admin_initial_q"
                        android:textColor="@color/admin_outline"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_thursday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_pending"
                        android:text="@string/admin_initial_s"
                        android:textColor="@color/admin_outline"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_friday" />
                </FrameLayout>
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1">
                    <TextView
                        style="@style/AdminText"
                        android:layout_width="@dimen/admin_day_size"
                        android:layout_height="@dimen/admin_day_size"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/admin_day_pending"
                        android:text="@string/admin_initial_s"
                        android:textColor="@color/admin_outline"
                        android:fontFamily="sans-serif"
                        android:textSize="@dimen/admin_day_text"
                        android:contentDescription="@string/admin_saturday" />
                </FrameLayout>
            </LinearLayout>
            <TextView
                style="@style/AdminText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:text="@string/admin_today" />
            <include
                android:id="@+id/agenda_today_strength"
                layout="@layout/admin_today_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_activity_gap" />
            <include
                android:id="@+id/agenda_today_yoga"
                layout="@layout/admin_yoga_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_activity_gap" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/agenda_add_today"
                style="@style/AdminButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/admin_button_height"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:text="@string/admin_add_activity" />
            <TextView
                style="@style/AdminText.Heading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:accessibilityHeading="true"
                android:text="@string/admin_tomorrow" />
            <include
                android:id="@+id/agenda_tomorrow_strength"
                layout="@layout/admin_today_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_activity_gap" />
            <include
                android:id="@+id/agenda_tomorrow_yoga"
                layout="@layout/admin_yoga_activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/admin_activity_gap" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/agenda_add_tomorrow"
                style="@style/AdminButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/admin_button_height"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="28dp"
                android:text="@string/admin_add_activity" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ImageButton
        android:id="@+id/accessibility_action"
        android:layout_width="@dimen/admin_touch_target"
        android:layout_height="@dimen/admin_touch_target"
        android:layout_margin="4dp"
        android:padding="0dp"
        android:background="@android:color/transparent"
        android:src="@drawable/admin_text_size_icon"
        android:contentDescription="@string/admin_resize_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation" />
    <include
        android:id="@+id/bottom_navigation"
        layout="@layout/admin_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
