<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flow_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fundo">
    <ScrollView
        android:id="@+id/ob_main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/fundo"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/ob_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <FrameLayout
                android:id="@+id/ob_profile_header"
                android:layout_width="match_parent"
                android:layout_height="305dp"
                android:background="@drawable/ob_profile_header_bg">
                <com.example.myapplication.onboarding.ProfileBannerBackgroundView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageButton
                        android:id="@+id/ob_back_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/ob_back"
                        android:src="@drawable/ic_voltar"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <ImageButton
                        android:id="@+id/ob_button_settings"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Configurações"
                        android:src="@drawable/ob_ic_settings"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <FrameLayout
                        android:id="@+id/ob_avatar_container"
                        android:layout_width="122dp"
                        android:layout_height="122dp"
                        android:layout_marginTop="38dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <ImageView
                            android:id="@+id/ob_profile_avatar"
                            android:layout_width="118dp"
                            android:layout_height="118dp"
                            android:layout_gravity="center"
                            android:contentDescription="Foto de perfil"
                            android:src="@drawable/ob_ic_avatar_placeholder" />
                        <ImageView
                            android:id="@+id/ob_button_add_avatar"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="4dp"
                            android:background="@drawable/ob_badge_add_avatar"
                            android:contentDescription="Alterar foto"
                            android:padding="5dp"
                            android:src="@drawable/ob_ic_add" />
                    </FrameLayout>
                    <TextView
                        android:id="@+id/ob_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/ob_perfil_name"
                        android:textColor="@color/ob_white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ob_avatar_container" />
                    <TextView
                        android:id="@+id/ob_user_birthdate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/ob_perfil_birthdate"
                        android:textColor="@color/ob_text_accent"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/ob_user_name" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="16dp">
                <LinearLayout
                    android:id="@+id/ob_card_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/ob_card_stats_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_peso_label"
                            android:textColor="@color/ob_text_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/ob_text_peso_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ob_peso_value"
                            android:textColor="@color/ob_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <View
                        android:layout_width="1dp"
                        android:layout_height="36dp"
                        android:background="@color/ob_border" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_altura_label"
                            android:textColor="@color/ob_text_accent"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/ob_text_altura_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/ob_altura_value"
                            android:textColor="@color/ob_white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_objetivo_title"
                            android:textColor="@color/ob_white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/ob_ver_tudo"
                            android:textColor="@color/ob_text_accent"
                            android:textSize="13sp"
                            android:id="@+id/flow_all_goals" />
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/ob_button_add_objetivo"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:contentDescription="Adicionar objetivo"
                        android:src="@drawable/ob_circle_outline_add" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/ob_objetivo_description"
                        android:textColor="@color/ob_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_meus_resultados_title"
                            android:textColor="@color/ob_white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/ob_ver_tudo"
                            android:textColor="@color/ob_text_accent"
                            android:textSize="13sp"
                            android:id="@+id/flow_all_results" />
                    </RelativeLayout>
                    <ImageView
                        android:id="@+id/ob_button_add_resultado"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:contentDescription="Adicionar resultado"
                        android:src="@drawable/ob_circle_outline_add" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/ob_meus_resultados_description"
                        android:textColor="@color/ob_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ob_meu_treino_title"
                            android:textColor="@color/ob_white"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="@string/ob_ver_tudo"
                            android:textColor="@color/ob_text_accent"
                            android:textSize="13sp"
                            android:id="@+id/flow_all_workouts" />
                    </RelativeLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <View
                            android:id="@+id/ob_workout_card_thumbnail"
                            android:layout_width="110dp"
                            android:layout_height="135dp"
                            android:background="@drawable/ob_workout_thumbnail_bg" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/ob_meu_treino_description"
                            android:textColor="@color/ob_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/ob_button_salvar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/ob_btn_salvar_bg"
                    android:text="@string/ob_salvar"
                    android:textAllCaps="false"
                    android:textColor="@color/ob_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/flow_bottom_navigation" />
</LinearLayout>
