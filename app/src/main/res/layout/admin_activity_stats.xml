<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="0dp"
    android:baselineAligned="false"
    android:theme="@style/Theme.MyApplication.Admin">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/admin_students"
            style="@style/AdminText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_students_functional" />
        <TextView
            style="@style/AdminText.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_students" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/admin_duration"
            style="@style/AdminText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_one_hour" />
        <TextView
            style="@style/AdminText.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_duration" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">
        <TextView
            android:id="@+id/admin_room"
            style="@style/AdminText.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_room_functional" />
        <TextView
            style="@style/AdminText.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/admin_room" />
    </LinearLayout>
</LinearLayout>
