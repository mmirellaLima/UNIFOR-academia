<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/admin_activity_height"
    android:background="@drawable/admin_activity_background"
    android:padding="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:theme="@style/Theme.MyApplication.Admin">
    <ImageView
        android:id="@+id/admin_icon"
        android:layout_width="@dimen/admin_activity_icon"
        android:layout_height="@dimen/admin_activity_icon"
        android:src="@drawable/admin_ic_yoga"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/admin_icon"
        app:layout_constraintEnd_toStartOf="@id/admin_student_group"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/admin_title"
            style="@style/AdminText.Heading"
            android:textSize="@dimen/admin_activity_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_yoga"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeMaxTextSize="@dimen/admin_activity_name" />
        <TextView
            android:id="@+id/admin_time"
            style="@style/AdminText.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/admin_time_yoga"
            android:textSize="8sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/admin_student_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@id/admin_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/admin_students"
            style="@style/AdminText.Heading"
            android:textSize="10sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_students_yoga" />
        <TextView
            style="@style/AdminText.Muted"
            android:textSize="9sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/admin_students" />
    </LinearLayout>
    <ImageView
        android:id="@+id/admin_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/admin_ic_next"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
