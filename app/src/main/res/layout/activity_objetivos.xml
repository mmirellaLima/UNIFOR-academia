<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/objetivos_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    tools:context=".ObjetivosActivity">

    <ImageView
        android:id="@+id/imgFundo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/meus_treinos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar"
        android:padding="8dp"
        android:src="@drawable/ic_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTituloObjetivos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:text="Quais os seus objetivos:"
        android:textColor="@color/titulo_objetivo"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollObjetivos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBotoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloObjetivos">

        <LinearLayout
            android:id="@+id/containerOpcoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/optEmagrecimento"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Emagrecimento"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optHipertrofia"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Hipertrofia Muscular"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optCondicionamento"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Condicionamento"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optTerapeutico"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Terapêutico"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optConvivio"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Convívio Social"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optOutros"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Outros"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/optLazer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_objetivo_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Lazer"
                android:textColor="@color/ob_white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutBotoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAcessibilidade"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAcaoVoltar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/ob_btn_voltar_bg"
            android:text="Voltar"
            android:textAllCaps="false"
            android:textColor="@color/preto_voltar"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarObjetivos"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/ob_btn_salvar_bg"
            android:text="Salvar"
            android:textAllCaps="false"
            android:textColor="@color/ob_white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnAcessibilidade"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/admin_accessibility_background"
        android:contentDescription="Tamanho da fonte"
        android:padding="6dp"
        android:src="@drawable/ic_fonte"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
