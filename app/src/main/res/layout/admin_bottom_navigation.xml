<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/admin_background"
    android:theme="@style/Theme.MyApplication.Admin">
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/admin_outline" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/admin_navigation_height"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="0dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:screenReaderFocusable="true"
            android:id="@+id/admin_nav_home"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/admin_navigation_icon"
                android:layout_height="@dimen/admin_navigation_icon"
                android:src="@drawable/ic_inicio"
                app:tint="@color/admin_navigation_active"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/AdminText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/admin_navigation_text"
                android:text="@string/admin_home"
                android:textColor="@color/admin_navigation_active"
                android:fontFamily="sans-serif" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:screenReaderFocusable="true"
            android:id="@+id/admin_nav_agenda"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/admin_navigation_icon"
                android:layout_height="@dimen/admin_navigation_icon"
                android:src="@drawable/admin_ic_agenda"
                app:tint="@color/admin_text"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/AdminText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/admin_navigation_text"
                android:text="@string/admin_agenda"
                android:textColor="@color/admin_text"
                android:fontFamily="sans-serif" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/admin_nav_chat"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/admin_navigation_ai"
                android:layout_width="@dimen/admin_ai_size"
                android:layout_height="@dimen/admin_ai_size"
                android:layout_gravity="center"
                android:contentDescription="@string/admin_ai"
                android:padding="10dp"
                android:src="@drawable/logo_chat"
                android:background="@drawable/admin_ai_background" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:screenReaderFocusable="true"
            android:id="@+id/admin_nav_training"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/admin_navigation_icon"
                android:layout_height="@dimen/admin_navigation_icon"
                android:src="@drawable/ic_treinos"
                app:tint="@color/admin_text"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/AdminText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/admin_navigation_text"
                android:text="@string/admin_workouts"
                android:textColor="@color/admin_text"
                android:fontFamily="sans-serif" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:screenReaderFocusable="true"
            android:id="@+id/admin_nav_profile"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="@dimen/admin_navigation_icon"
                android:layout_height="@dimen/admin_navigation_icon"
                android:src="@drawable/ic_perfil"
                app:tint="@color/admin_text"
                android:importantForAccessibility="no" />
            <TextView
                style="@style/AdminText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/admin_navigation_text"
                android:text="@string/admin_profile"
                android:textColor="@color/admin_text"
                android:fontFamily="sans-serif" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
