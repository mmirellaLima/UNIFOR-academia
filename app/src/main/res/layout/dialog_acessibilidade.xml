<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F8F8"
    android:orientation="vertical">

    <!-- Cabeçalho azul -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0A4DFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Menu de Acessibilidade"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnResetar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Restaurar tamanho padrão"
            android:padding="8dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="@android:color/white"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/btnFechar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Fechar"
            android:gravity="center"
            android:text="✕"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Card: Ajustar tamanho da fonte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_acess"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_tamanho_fonte" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ajustar tamanho da fonte"
                android:textColor="#111111"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnDiminuir"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circulo_azul"
                android:contentDescription="Diminuir fonte"
                android:padding="8dp"
                android:src="@drawable/ic_menos" />

            <TextView
                android:id="@+id/tvPorcentagem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="100%"
                android:textColor="#111111"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnAumentar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circulo_azul"
                android:contentDescription="Aumentar fonte"
                android:padding="8dp"
                android:src="@drawable/ic_mais" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>