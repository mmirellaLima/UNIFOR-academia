<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/feed_font_close" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="end" android:background="@drawable/feed_font_close_background" app:backgroundTint="#5E83EA" android:minWidth="0dp" android:minHeight="0dp" android:text="×" android:textSize="22sp" android:textColor="#FFFFFF" android:contentDescription="@string/feed_font_close" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/feed_font_panel_background">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:layout_marginEnd="8dp" android:src="@drawable/ic_fonte" app:tint="#FFFFFF" android:importantForAccessibility="no" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/feed_font_title" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:labelFor="@id/feed_font_slider" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginTop="12dp" android:paddingHorizontal="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/feed_font_slider_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" android:textColor="#FFFFFF" android:textSize="12sp" android:importantForAccessibility="no" />
            <androidx.appcompat.widget.AppCompatSeekBar android:id="@+id/feed_font_slider" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:max="50" android:progress="0" android:splitTrack="false" android:progressTint="#A8BFFF" android:thumbTint="#DCE5FF" android:contentDescription="@string/feed_font_title" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="22sp" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
