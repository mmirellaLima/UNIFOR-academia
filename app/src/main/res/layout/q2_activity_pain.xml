<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/q2_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#191A1E">
    <com.example.myapplication.questionario2.RegistrationBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageButton
        android:id="@+id/q2_back_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/q2_back_arrow"
        android:contentDescription="@string/q2_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="@string/q2_step"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/q2_back_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ScrollView
        android:id="@+id/q2_form_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/q2_back_button"
        app:layout_constraintBottom_toTopOf="@id/q2_next_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">
            <ImageView
                android:layout_width="57dp"
                android:layout_height="57dp"
                android:padding="14dp"
                android:background="@drawable/q2_badge_background"
                android:src="@drawable/q2_dumbbell"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginHorizontal="24dp"
                android:gravity="center"
                android:text="@string/q2_pain_question"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:lineSpacingExtra="0dp" />
            <LinearLayout
                android:id="@+id/q2_pain_choices"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="40dp"
                android:layout_marginHorizontal="38dp"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q2_pain_no"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="@string/q2_no"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#2D238D"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#E7F4FC"
                    app:cornerRadius="16dp"
                    android:checkable="true"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/q2_choice_stroke" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/q2_pain_yes"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:layout_marginStart="16dp"
                    android:text="@string/q2_yes"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#2D238D"
                    app:cornerRadius="16dp"
                    android:checkable="true"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/q2_choice_stroke"
                    app:icon="@drawable/q2_thumb_up"
                    app:iconTint="#FFFFFF"
                    app:iconSize="20dp"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="@string/q2_pain_detail_question"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:labelFor="@id/q2_pain_input" />
            <EditText
                android:id="@+id/q2_pain_input"
                android:layout_width="match_parent"
                android:layout_height="138dp"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="40dp"
                android:background="@drawable/q2_injury_answer_background"
                android:enabled="false"
                android:padding="16dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="500"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:importantForAutofill="no" />
        </LinearLayout>
    </ScrollView>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/q2_next_button"
        android:layout_width="134dp"
        android:layout_height="54dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/q2_next_background"
        app:backgroundTint="#2D238D"
        android:text="@string/q2_next"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="2dp"
        android:text="@string/q2_pain_progress_value"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/q2_registration_progress" />
    <ProgressBar
        android:id="@+id/q2_registration_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="26dp"
        android:layout_marginBottom="6dp"
        android:max="100"
        android:progress="85"
        android:progressDrawable="@drawable/q2_registration_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
