<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/barraInferior"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fundo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Início"
            android:src="@drawable/ic_inicio"
            app:tint="@android:color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Início"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Progresso"
            android:src="@drawable/ic_progresso"
            app:tint="@android:color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progresso"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/btnChat"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_logo"
        android:contentDescription="Logo"
        android:padding="16dp"
        android:src="@drawable/logo_chat"
        app:tint="@android:color/white" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Treinos"
            android:src="@drawable/ic_treinos"
            app:tint="@color/azul_selecionado" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Treinos"
            android:textColor="@color/azul_selecionado"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/btnPerfil"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Perfil"
            android:src="@drawable/ic_perfil"
            app:tint="@android:color/white" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil"
            android:textColor="@android:color/white"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
