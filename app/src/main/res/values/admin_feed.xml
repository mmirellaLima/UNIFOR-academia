    <style
        name="Theme.MyApplication.Admin"
        parent="Theme.MyApplication">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/admin_background</item>
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorOnPrimary">@color/admin_text</item>
        <item name="colorSurface">@color/admin_background</item>
        <item name="android:colorAccent">@color/admin_primary</item>
    </style>
    <style
        name="AdminText"
        parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:textSize">@dimen/admin_body_size</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdminText.Muted">
        <item name="android:textColor">@color/admin_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AdminText.Heading">
        <item name="android:textSize">@dimen/admin_section_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AdminText.Title">
        <item name="android:textSize">@dimen/admin_title_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AdminText.Value">
        <item name="android:textSize">@dimen/admin_value_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AdminText.Time">
        <item name="android:textSize">9sp</item>
        <item name="android:background">@drawable/admin_time_background</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style
        name="AdminButton"
        parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/admin_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/admin_text</item>
        <item name="android:textSize">@dimen/admin_button_size</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="AdminButton.Danger">
        <item name="android:background">@drawable/admin_danger_background</item>
        <item name="android:textSize">10sp</item>
    </style>
    <style
        name="AdminSelector"
        parent="AdminText">
        <item name="android:textSize">@dimen/admin_selector_text</item>
        <item name="android:background">@drawable/admin_selector_background</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:drawableEnd">@drawable/admin_ic_dropdown</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="AdminPanelAnimation">
        <item name="android:windowEnterAnimation">@anim/admin_panel_enter</item>
        <item name="android:windowExitAnimation">@anim/admin_panel_exit</item>
    </style>
    <style
        name="AdminCalendarTheme"
        parent="Theme.Material3.Light.Dialog">
        <item name="colorPrimary">@color/admin_primary</item>
        <item name="colorSecondary">@color/admin_primary</item>
        <item name="colorControlActivated">@color/admin_primary</item>
        <item name="android:colorControlActivated">@color/admin_primary</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">@color/admin_primary</item>
        <item name="android:windowNoTitle">true</item>
    </style>
